# ─────────────────────────────────────────────
# customer-churn-capstone — Environment Example
# Copy this file to .env and fill in values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────

# Application Environment
APP_ENV=development

# FastAPI Backend Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Model Artifact Path (relative to project root)
MODEL_PATH=model/churn_pipeline.joblib

# Frontend → Backend URL
# Local development:  http://localhost:8000
# Docker Compose:     http://backend:8000
# Cloud deployment:   https://your-backend-service.onrender.com
BACKEND_URL=http://localhost:8000

# Python
PYTHONUNBUFFERED=1
